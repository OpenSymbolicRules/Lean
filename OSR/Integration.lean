    have h1 := ((hasDerivAt_id' t).mul hU.cos).mul_const
      (env "b" ^ 2 * env "d" ^ 2 * env "n" ^ 2 + 1)⁻¹
    have h2 := (((hasDerivAt_id' t).const_mul (env "b" * env "d" * env "n")).mul
