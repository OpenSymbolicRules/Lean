import OSR.Rule

/-!
# Reference rewriter

A small syntactic rewriting engine over `Expr`, with its soundness proved
against `Rule.Sound`:

* `matchExpr p e` matches a pattern syntactically (non-linear patterns compare
  subterms for equality); `matchAux_spec` proves that the resulting
  substitution instantiates the pattern to `e`;
* `Rule.rewrite_sound`: one root rewrite with a sound rule preserves
  definedness and value;
* `rewriteStep` rewrites the outermost-leftmost redex, trying rules in list
  order; `rewriteStep_sound` lifts root soundness through every context;
* `normalize` iterates `rewriteStep` within a step budget;
  `normalize_sound` proves the final expression is defined and equal to the
  input whenever the input is defined.

Rules with conditions are never applied: the engine cannot decide them.  The
engine is the semantic reference for external engines (see the Conformance
cases generated by the exporter) and the tool that checks profiles for
termination on the catalogue patterns.  Termination itself is *tested*, not
proved.
-/

namespace OSR

/-- A substitution: an association list from variable names to expressions.
Unassigned variables are left unchanged. -/
abbrev Subst := List (String × Expr)

namespace Subst

/-- The binding of a variable, if any (first match). -/
def find? : Subst → String → Option Expr
  | [], _ => none
  | (k, v) :: s, n => if k = n then some v else find? s n

/-- The expression substituted for a variable. -/
def apply (σ : Subst) (n : String) : Expr := (σ.find? n).getD (.var n)

/-- `τ` keeps every binding of `σ`. -/
def Extends (σ τ : Subst) : Prop := ∀ n e, σ.find? n = some e → τ.find? n = some e

theorem Extends.refl (σ : Subst) : σ.Extends σ := fun _ _ h => h

theorem Extends.trans {σ τ υ : Subst} (h₁ : σ.Extends τ) (h₂ : τ.Extends υ) :
    σ.Extends υ := fun n e h => h₂ n e (h₁ n e h)

end Subst

namespace Expr

/-- Simultaneous substitution of variables. -/
def subst (σ : Subst) : Expr → Expr
  | .var n => σ.apply n
  | .int z => .int z
  | .const c => .const c
  | .app1 o a => .app1 o (a.subst σ)
  | .app2 o a b => .app2 o (a.subst σ) (b.subst σ)
  | .powNat a k => .powNat (a.subst σ) k
  | .powNeg a k => .powNeg (a.subst σ) k

/-- Variable occurrences, with repetitions, left to right. -/
def varList : Expr → List String
  | .var n => [n]
  | .int _ | .const _ => []
  | .app1 _ a => a.varList
  | .app2 _ a b => a.varList ++ b.varList
  | .powNat a _ | .powNeg a _ => a.varList

end Expr

/-- Syntactic matching of a pattern against an expression, extending `σ`. -/
def matchAux : Expr → Expr → Subst → Option Subst
  | .var n, e, σ =>
    match σ.find? n with
    | some e' => if e' = e then some σ else none
    | none => some ((n, e) :: σ)
  | .int z, .int z', σ => if z = z' then some σ else none
  | .const c, .const c', σ => if c = c' then some σ else none
  | .app1 o a, .app1 o' a', σ => if o = o' then matchAux a a' σ else none
  | .app2 o a b, .app2 o' a' b', σ =>
    if o = o' then
      match matchAux a a' σ with
      | some σ₁ => matchAux b b' σ₁
      | none => none
    else none
  | .powNat a k, .powNat a' k', σ => if k = k' then matchAux a a' σ else none
  | .powNeg a k, .powNeg a' k', σ => if k = k' then matchAux a a' σ else none
  | _, _, _ => none

/-- Match a pattern against an expression from the empty substitution. -/
def matchExpr (p e : Expr) : Option Subst := matchAux p e []

/-- A successful match extends the input substitution, and any extension of
the result instantiates the pattern to the matched expression. -/
theorem matchAux_spec : ∀ (p e : Expr) (σ σ' : Subst), matchAux p e σ = some σ' →
    σ.Extends σ' ∧ ∀ τ : Subst, σ'.Extends τ → p.subst τ = e
  | .var n, e, σ, σ', h => by
    unfold matchAux at h
    split at h
    · rename_i e' hf
      split at h
      · rename_i heq
        cases h
        refine ⟨Subst.Extends.refl _, fun τ hτ => ?_⟩
        simp [Expr.subst, Subst.apply, hτ n e' hf, heq]
      · cases h
    · rename_i hf
      cases h
      refine ⟨fun k x hk => ?_, fun τ hτ => ?_⟩
      · simp only [Subst.find?]
        split
        · rename_i hnk
          subst hnk
          rw [hf] at hk
          cases hk
        · exact hk
      · have : Subst.find? ((n, e) :: σ) n = some e := by simp [Subst.find?]
        simp [Expr.subst, Subst.apply, hτ n e this]
  | .int z, e, σ, σ', h => by
    cases e <;> simp only [matchAux, reduceCtorEq] at h
    rename_i z'
    split at h
    · rename_i hz
      cases h
      exact ⟨Subst.Extends.refl _, fun _ _ => by simp [Expr.subst, hz]⟩
    · cases h
  | .const c, e, σ, σ', h => by
    cases e <;> simp only [matchAux, reduceCtorEq] at h
    rename_i c'
    split at h
    · rename_i hc
      cases h
      exact ⟨Subst.Extends.refl _, fun _ _ => by cases hc; rfl⟩
    · cases h
  | .app1 o a, e, σ, σ', h => by
    cases e <;> simp only [matchAux, reduceCtorEq] at h
    rename_i o' a'
    split at h
    · rename_i ho
      obtain ⟨hext, hsub⟩ := matchAux_spec a a' σ σ' h
      exact ⟨hext, fun τ hτ => by simp [Expr.subst, hsub τ hτ, ho]⟩
    · cases h
  | .app2 o a b, e, σ, σ', h => by
    cases e <;> simp only [matchAux, reduceCtorEq] at h
    rename_i o' a' b'
    split at h
    · rename_i ho
      split at h
      · rename_i σ₁ h₁
        obtain ⟨hext₁, hsub₁⟩ := matchAux_spec a a' σ σ₁ h₁
        obtain ⟨hext₂, hsub₂⟩ := matchAux_spec b b' σ₁ σ' h
        refine ⟨hext₁.trans hext₂, fun τ hτ => ?_⟩
        simp [Expr.subst, hsub₁ τ (hext₂.trans hτ), hsub₂ τ hτ, ho]
      · cases h
    · cases h
  | .powNat a k, e, σ, σ', h => by
    cases e <;> simp only [matchAux, reduceCtorEq] at h
    rename_i a' k'
    split at h
    · rename_i hk
      obtain ⟨hext, hsub⟩ := matchAux_spec a a' σ σ' h
      exact ⟨hext, fun τ hτ => by simp [Expr.subst, hsub τ hτ, hk]⟩
    · cases h
  | .powNeg a k, e, σ, σ', h => by
    cases e <;> simp only [matchAux, reduceCtorEq] at h
    rename_i a' k'
    split at h
    · rename_i hk
      obtain ⟨hext, hsub⟩ := matchAux_spec a a' σ σ' h
      exact ⟨hext, fun τ hτ => by simp [Expr.subst, hsub τ hτ, hk]⟩
    · cases h

theorem matchExpr_subst {p e : Expr} {σ : Subst} (h : matchExpr p e = some σ) :
    p.subst σ = e :=
  (matchAux_spec p e [] σ h).2 σ (Subst.Extends.refl σ)

section Semantics

variable {α : Type} [Field α]

/-- The assignment induced by a substitution. -/
def Subst.env (I : Interp α) (env : String → α) (σ : Subst) : String → α :=
  fun n => eval I env (σ.apply n)

theorem eval_subst (I : Interp α) (env : String → α) (σ : Subst) :
    ∀ e : Expr, eval I env (e.subst σ) = eval I (σ.env I env) e
  | .var n => by simp [Expr.subst, eval, Subst.env]
  | .int z => by simp [Expr.subst, eval]
  | .const c => by cases c; simp [Expr.subst, eval]
  | .app1 o a => by
    cases o <;> simp [Expr.subst, eval, eval_subst I env σ a]
  | .app2 o a b => by
    cases o <;> simp [Expr.subst, eval, eval_subst I env σ a, eval_subst I env σ b]
  | .powNat a k => by simp [Expr.subst, eval, eval_subst I env σ a]
  | .powNeg a k => by simp [Expr.subst, eval, eval_subst I env σ a]

theorem defined_subst (I : Interp α) (env : String → α) (σ : Subst) :
    ∀ e : Expr, Defined I env (e.subst σ) ↔
      Defined I (σ.env I env) e ∧ ∀ n ∈ e.varList, Defined I env (σ.apply n)
  | .var n => by simp [Expr.subst, Defined, Expr.varList]
  | .int z => by simp [Expr.subst, Defined, Expr.varList]
  | .const c => by simp [Expr.subst, Defined, Expr.varList]
  | .app1 o a => by
    have ih := defined_subst I env σ a
    cases o <;> simp only [Expr.subst, Defined, Expr.varList, eval_subst, ih] <;> tauto
  | .app2 o a b => by
    have iha := defined_subst I env σ a
    have ihb := defined_subst I env σ b
    cases o <;>
      simp only [Expr.subst, Defined, Expr.varList, eval_subst, iha, ihb, List.mem_append,
        or_imp, forall_and] <;> tauto
  | .powNat a k => by
    simp only [Expr.subst, Defined, Expr.varList, defined_subst I env σ a]
  | .powNeg a k => by
    simp only [Expr.subst, Defined, Expr.varList, defined_subst I env σ a, eval_subst]
    tauto

end Semantics

/-- The replacement only uses variables bound by the pattern. -/
def Rule.rhsClosed (r : Rule) : Bool :=
  r.rhs.varList.all (· ∈ r.lhs.varList)

section Soundness

variable {α : Type} [Field α]

/-- One root rewrite with a sound, closed rule preserves definedness and value.
The conditions are evaluated under the assignment induced by the match. -/
theorem Rule.rewrite_sound {r : Rule} {I : Interp α} (hs : r.Sound I)
    (hc : r.rhsClosed = true) {env : String → α} {e : Expr} {σ : Subst}
    (hm : matchExpr r.lhs e = some σ)
    (hcond : ∀ c ∈ r.conditions, c.Holds I (σ.env I env)) (hd : Defined I env e) :
    Defined I env (r.rhs.subst σ) ∧ eval I env e = eval I env (r.rhs.subst σ) := by
  have he := matchExpr_subst hm
  subst he
  obtain ⟨hdl, hv⟩ := (defined_subst I env σ r.lhs).1 hd
  obtain ⟨hdr, heq⟩ := hs _ hcond hdl
  refine ⟨(defined_subst I env σ r.rhs).2 ⟨hdr, fun n hn => hv n ?_⟩, ?_⟩
  · simp only [Rule.rhsClosed, List.all_eq_true, decide_eq_true_eq] at hc
    exact hc n hn
  · rw [eval_subst, eval_subst, heq]

end Soundness

/-- Rewrite at the root with the first unconditional rule whose pattern
matches.  Returns the rule id and the result. -/
def rootRewrite : List Rule → Expr → Option (String × Expr)
  | [], _ => none
  | r :: rs, e =>
    if r.conditions.isEmpty then
      match matchExpr r.lhs e with
      | some σ => some (r.id, r.rhs.subst σ)
      | none => rootRewrite rs e
    else rootRewrite rs e

/-- One outermost-leftmost rewrite step. -/
def rewriteStep (rules : List Rule) : Expr → Option (String × Expr)
  | .app1 o a =>
    match rootRewrite rules (.app1 o a) with
    | some s => some s
    | none =>
      match rewriteStep rules a with
      | some s => some (s.1, .app1 o s.2)
      | none => none
  | .app2 o a b =>
    match rootRewrite rules (.app2 o a b) with
    | some s => some s
    | none =>
      match rewriteStep rules a with
      | some s => some (s.1, .app2 o s.2 b)
      | none =>
        match rewriteStep rules b with
        | some s => some (s.1, .app2 o a s.2)
        | none => none
  | .powNat a k =>
    match rootRewrite rules (.powNat a k) with
    | some s => some s
    | none =>
      match rewriteStep rules a with
      | some s => some (s.1, .powNat s.2 k)
      | none => none
  | .powNeg a k =>
    match rootRewrite rules (.powNeg a k) with
    | some s => some s
    | none =>
      match rewriteStep rules a with
      | some s => some (s.1, .powNeg s.2 k)
      | none => none
  | e => rootRewrite rules e

/-- Outcome of `normalize`. -/
structure Normalization where
  /-- The last expression reached. -/
  result : Expr
  /-- Ids of the rules applied, in order. -/
  trace : List String
  /-- Whether `result` is a normal form (no rule applies). -/
  normal : Bool
  deriving Repr, Inhabited, BEq

/-- Rewrite until a normal form is reached or `fuel` steps are spent. -/
def normalize (rules : List Rule) : Nat → Expr → Normalization
  | 0, e => ⟨e, [], (rewriteStep rules e).isNone⟩
  | fuel + 1, e =>
    match rewriteStep rules e with
    | none => ⟨e, [], true⟩
    | some (id, e') =>
      let n := normalize rules fuel e'
      ⟨n.result, id :: n.trace, n.normal⟩

section EngineSoundness

variable {α : Type} [Field α] {I : Interp α} {env : String → α}

/-- The rules an engine may apply soundly.  The engine never applies a rule
with conditions, so only the unconditional rules need to be sound. -/
def RulesSound (I : Interp α) (rules : List Rule) : Prop :=
  ∀ r ∈ rules, r.conditions.isEmpty → r.Sound I ∧ r.rhsClosed = true

/-- "`a` may be replaced by `a'`": definedness and value are preserved. -/
def Preserves (I : Interp α) (env : String → α) (a a' : Expr) : Prop :=
  Defined I env a → Defined I env a' ∧ eval I env a = eval I env a'

theorem Preserves.refl (a : Expr) : Preserves I env a a := fun h => ⟨h, rfl⟩

theorem Preserves.trans {a b c : Expr} (h₁ : Preserves I env a b)
    (h₂ : Preserves I env b c) : Preserves I env a c := fun h =>
  let ⟨d₁, e₁⟩ := h₁ h
  let ⟨d₂, e₂⟩ := h₂ d₁
  ⟨d₂, e₁.trans e₂⟩

theorem Preserves.app1 (o : Op1) {a a' : Expr} (h : Preserves I env a a') :
    Preserves I env (.app1 o a) (.app1 o a') := by
  cases o <;> simp only [Preserves, Defined, eval] at h ⊢ <;> intro hd
  all_goals first
    | (obtain ⟨h₁, h₂⟩ := h hd; exact ⟨h₁, by rw [h₂]⟩)
    | (obtain ⟨h₁, h₂⟩ := h hd.1; exact ⟨⟨h₁, by rw [← h₂]; exact hd.2⟩, by rw [h₂]⟩)

theorem Preserves.app2 (o : Op2) {a a' b b' : Expr} (ha : Preserves I env a a')
    (hb : Preserves I env b b') : Preserves I env (.app2 o a b) (.app2 o a' b') := by
  cases o <;> simp only [Preserves, Defined, eval] at ha hb ⊢ <;> intro hd
  all_goals first
    | (obtain ⟨a₁, a₂⟩ := ha hd.1; obtain ⟨b₁, b₂⟩ := hb hd.2.1
       exact ⟨⟨a₁, b₁, by rw [← b₂]; exact hd.2.2⟩, by rw [a₂, b₂]⟩)
    | (obtain ⟨a₁, a₂⟩ := ha hd.1; obtain ⟨b₁, b₂⟩ := hb hd.2
       exact ⟨⟨a₁, b₁⟩, by rw [a₂, b₂]⟩)

theorem Preserves.powNat (k : Nat) {a a' : Expr} (h : Preserves I env a a') :
    Preserves I env (.powNat a k) (.powNat a' k) := by
  simp only [Preserves, Defined, eval] at h ⊢
  intro hd
  obtain ⟨h₁, h₂⟩ := h hd
  exact ⟨h₁, by rw [h₂]⟩

theorem Preserves.powNeg (k : Nat) {a a' : Expr} (h : Preserves I env a a') :
    Preserves I env (.powNeg a k) (.powNeg a' k) := by
  simp only [Preserves, Defined, eval] at h ⊢
  intro hd
  obtain ⟨h₁, h₂⟩ := h hd.1
  exact ⟨⟨h₁, by rw [← h₂]; exact hd.2⟩, by rw [h₂]⟩

theorem rootRewrite_sound : ∀ (rules : List Rule) (e : Expr) (s : String × Expr),
    RulesSound I rules → rootRewrite rules e = some s → Preserves I env e s.2
  | [], _, _, _, h => by simp [rootRewrite] at h
  | r :: rs, e, s, hr, h => by
    have hrs : RulesSound I rs := fun r' h' => hr r' (List.mem_cons_of_mem _ h')
    unfold rootRewrite at h
    split at h
    · rename_i hempty
      split at h
      · rename_i σ hm
        simp only [Option.some.injEq] at h
        subst h
        obtain ⟨hs, hc⟩ := hr r List.mem_cons_self hempty
        intro hd
        refine Rule.rewrite_sound hs hc hm (fun c hc' => ?_) hd
        simp only [List.isEmpty_iff] at hempty
        simp [hempty] at hc'
      · exact rootRewrite_sound rs e s hrs h
    · exact rootRewrite_sound rs e s hrs h

theorem rewriteStep_sound (rules : List Rule) (hr : RulesSound I rules) :
    ∀ (e : Expr) (s : String × Expr), rewriteStep rules e = some s → Preserves I env e s.2
  | .var n, s, h => rootRewrite_sound rules _ s hr (by simpa [rewriteStep] using h)
  | .int z, s, h => rootRewrite_sound rules _ s hr (by simpa [rewriteStep] using h)
  | .const c, s, h => rootRewrite_sound rules _ s hr (by simpa [rewriteStep] using h)
  | .app1 o a, s, h => by
    simp only [rewriteStep] at h
    split at h
    · rename_i s' hroot
      simp only [Option.some.injEq] at h
      subst h
      exact rootRewrite_sound rules _ s' hr hroot
    · split at h
      · rename_i s' hs
        simp only [Option.some.injEq] at h
        subst h
        exact Preserves.app1 o (rewriteStep_sound rules hr a s' hs)
      · cases h
  | .app2 o a b, s, h => by
    simp only [rewriteStep] at h
    split at h
    · rename_i s' hroot
      simp only [Option.some.injEq] at h
      subst h
      exact rootRewrite_sound rules _ s' hr hroot
    · split at h
      · rename_i s' hs
        simp only [Option.some.injEq] at h
        subst h
        exact Preserves.app2 o (rewriteStep_sound rules hr a s' hs) (Preserves.refl b)
      · split at h
        · rename_i s' hs
          simp only [Option.some.injEq] at h
          subst h
          exact Preserves.app2 o (Preserves.refl a) (rewriteStep_sound rules hr b s' hs)
        · cases h
  | .powNat a k, s, h => by
    simp only [rewriteStep] at h
    split at h
    · rename_i s' hroot
      simp only [Option.some.injEq] at h
      subst h
      exact rootRewrite_sound rules _ s' hr hroot
    · split at h
      · rename_i s' hs
        simp only [Option.some.injEq] at h
        subst h
        exact Preserves.powNat k (rewriteStep_sound rules hr a s' hs)
      · cases h
  | .powNeg a k, s, h => by
    simp only [rewriteStep] at h
    split at h
    · rename_i s' hroot
      simp only [Option.some.injEq] at h
      subst h
      exact rootRewrite_sound rules _ s' hr hroot
    · split at h
      · rename_i s' hs
        simp only [Option.some.injEq] at h
        subst h
        exact Preserves.powNeg k (rewriteStep_sound rules hr a s' hs)
      · cases h

/-- **Engine soundness.**  Normalizing a defined expression with sound rules
yields a defined expression with the same value, whatever the step budget. -/
theorem normalize_sound (rules : List Rule) (hr : RulesSound I rules) :
    ∀ (fuel : Nat) (e : Expr), Preserves I env e (normalize rules fuel e).result
  | 0, e => by simpa [normalize] using Preserves.refl e
  | fuel + 1, e => by
    simp only [normalize]
    split
    · exact Preserves.refl e
    · rename_i id e' hs
      exact (rewriteStep_sound rules hr e (id, e') hs).trans (normalize_sound rules hr fuel e')

end EngineSoundness

end OSR
